{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lan-chat",
  "version": "0.1.1",
  "identifier": "com.rubenely.lanchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LAN-Chat",
        "width": 1160,
        "height": 760,
        "minWidth": 640,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer.nsh",
        "installMode": "perMachine"
      }
    }
  }
}
